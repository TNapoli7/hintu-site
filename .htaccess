# Hintu · hintu.pt (Hostinger / Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Nunca expor a pasta interna do Git
RedirectMatch 404 /\.git
# Endereços antigos /assets/... passam a viver na raiz
RewriteRule ^assets/(?:fonts/)?(.+)$ /$1 [L,R=301]
# Sempre HTTPS e sem www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hintu.pt%{REQUEST_URI} [L,R=301]
# /privacidade serve privacidade.html; /privacidade.html redireciona para o endereço limpo
RewriteCond %{THE_REQUEST} \s/+privacidade\.html[\s?] [NC]
RewriteRule ^ /privacidade [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

# Segurança
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
AddType font/woff2 .woff2
AddType image/svg+xml .svg
